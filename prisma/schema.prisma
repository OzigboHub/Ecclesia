generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                         String                       @id @default(uuid())
  name                       String                       @unique
  level                      HierarchyLevel
  parentId                   String?
  address                    String?
  contactEmail               String?
  contactPhone               String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  autoGenerateMasses         Boolean                      @default(true)
  generateDaysInAdvance      Int                          @default(90)
  maxMassesPerDay            Int                          @default(5)
  minMassesPerDay            Int                          @default(1)
  appointmentBookingClosesAt DateTime?
  appointmentBookingOpensAt  DateTime?
  appointments               Appointment[]
  appointmentAvailabilities  AppointmentAvailability[]
  appointmentUnavailableDays AppointmentUnavailableDay[]
  baptisms                   Baptism[]
  confirmations              Confirmation[]
  donations                  Donation[]
  donationCampaigns          DonationCampaign[]
  events                     Event[]
  liveStreams                LiveStream[]
  marriages                  Marriage[]
  masses                     Mass[]
  massIntentions             MassIntention[]
  massScheduleTemplates      MassScheduleTemplate[]
  parent                     Organization?                @relation("ChildOrganizations", fields: [parentId], references: [id])
  children                   Organization[]               @relation("ChildOrganizations")
  featureSettings            OrganizationFeatureSettings?
  parishioners               Parishioner[]
  payments                   Payment[]
  sacraments                 Sacrament[]
  societies                  Society[]
  users                      User[]

  @@index([parentId])
}

model OrganizationFeatureSettings {
  id                          String       @id @default(uuid())
  organizationId              String       @unique
  enableParishionerManagement Boolean      @default(true)
  enableSacramentalRecords    Boolean      @default(true)
  enableFinancialManagement   Boolean      @default(true)
  enableOfferings             Boolean      @default(true)
  enableTithes                Boolean      @default(true)
  enableDonationCampaigns     Boolean      @default(true)
  enableCustomDonationTypes   Boolean      @default(true)
  enableMonthlyTracking       Boolean      @default(true)
  enableMassIntentions        Boolean      @default(true)
  enableAppointments          Boolean      @default(true)
  enableConfessionBooking     Boolean      @default(true)
  enableLiveStreaming         Boolean      @default(false)
  enableAnnouncements         Boolean      @default(true)
  enableSMSNotifications      Boolean      @default(false)
  enableEmailNotifications    Boolean      @default(true)
  enableEventManagement       Boolean      @default(true)
  enableOnlinePayments        Boolean      @default(false)
  enableRecurringDonations    Boolean      @default(false)
  enableMobileApp             Boolean      @default(false)
  enablePublicWebsite         Boolean      @default(true)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  enableSocieties             Boolean      @default(true)
  organization                Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model User {
  id                   String                    @id @default(uuid())
  email                String                    @unique
  password             String
  firstName            String
  lastName             String
  role                 UserRole
  isActive             Boolean                   @default(true)
  lastLogin            DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  organizationId       String
  address              String?
  dateOfBirth          DateTime?
  phone                String?
  failedLoginAttempts  Int                       @default(0)
  lastFailedLoginAt    DateTime?
  lockedUntil          DateTime?
  sessionVersion       Int                       @default(1)
  appointmentsAssigned Appointment[]             @relation("AppointmentAssignee")
  appointmentsMade     Appointment[]             @relation("AppointmentCreator")
  availabilitySlots    AppointmentAvailability[] @relation("AppointmentAvailabilityAssignee")
  passwordResetTokens  PasswordResetToken[]
  paymentsRecorded     Payment[]                 @relation("PaymentRecorder")
  societyLed           Society?                  @relation("SocietyPresident")
  societyAssisted      Society?                  @relation("SocietySecretary")
  reviewedJoinRequests SocietyJoinRequest[]      @relation("JoinRequestReviewer")
  organization         Organization              @relation(fields: [organizationId], references: [id])
  sessions             UserSession[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenId    String    @unique
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model MassScheduleTemplate {
  id             String       @id @default(uuid())
  dayOfWeek      DayOfWeek
  time           String
  massType       MassType     @default(DAILY_MASS)
  language       String?
  location       String?
  isActive       Boolean      @default(true)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([dayOfWeek])
  @@index([isActive])
}

model Mass {
  id                 String          @id @default(uuid())
  date               DateTime
  time               String
  massType           MassType
  status             MassStatus      @default(SCHEDULED)
  language           String?
  location           String?
  celebrant          String?
  maxIntentions      Int             @default(1)
  bookedIntentions   Int             @default(0)
  templateId         String?
  isAutoGenerated    Boolean         @default(true)
  modifiedBy         String?
  cancellationReason String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id])
  intentions         MassIntention[]

  @@unique([organizationId, date, time])
  @@index([organizationId])
  @@index([date])
  @@index([status])
  @@index([massType])
}

model Society {
  id              String               @id @default(uuid())
  name            String
  description     String?
  organizationId  String
  presidentId     String?              @unique
  secretaryId     String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  meetingSchedule String?
  patronSaint     String?
  events          Event[]
  payments        Payment[]
  organization    Organization         @relation(fields: [organizationId], references: [id])
  president       User?                @relation("SocietyPresident", fields: [presidentId], references: [id])
  secretary       User?                @relation("SocietySecretary", fields: [secretaryId], references: [id])
  joinRequests    SocietyJoinRequest[]
  members         SocietyMembership[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([presidentId])
  @@index([secretaryId])
}

model Parishioner {
  id                 String               @id @default(uuid())
  firstName          String
  lastName           String
  otherNames         String?
  email              String?              @unique
  phone              String?
  address            String?
  dateOfBirth        DateTime?
  gender             Gender?
  maritalStatus      MaritalStatus?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  occupation         String?
  deletedAt          DateTime?
  isActive           Boolean              @default(true)
  photoUrl           String?
  organizationId     String
  appointments       Appointment[]        @relation("ParishionerAppointment")
  baptisms           Baptism[]
  confirmations      Confirmation[]
  eventAttendances   EventAttendance[]
  marriagesAsHusband Marriage[]           @relation("MarriageHusband")
  marriagesAsWife    Marriage[]           @relation("MarriageWife")
  massIntentions     MassIntention[]
  organization       Organization         @relation(fields: [organizationId], references: [id])
  payments           Payment[]
  sacraments         Sacrament[]
  joinRequests       SocietyJoinRequest[]
  societyMemberships SocietyMembership[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model SocietyJoinRequest {
  id            String            @id @default(uuid())
  parishionerId String
  societyId     String
  status        JoinRequestStatus @default(PENDING)
  message       String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  parishioner   Parishioner       @relation(fields: [parishionerId], references: [id])
  reviewedBy    User?             @relation("JoinRequestReviewer", fields: [reviewedById], references: [id])
  society       Society           @relation(fields: [societyId], references: [id])

  @@unique([parishionerId, societyId])
  @@index([societyId])
  @@index([parishionerId])
  @@index([status])
}

model SocietyMembership {
  parishionerId String
  societyId     String
  joinedAt      DateTime    @default(now())
  role          SocietyRole @default(MEMBER)
  parishioner   Parishioner @relation(fields: [parishionerId], references: [id])
  society       Society     @relation(fields: [societyId], references: [id])

  @@id([parishionerId, societyId])
  @@index([societyId])
}

model Sacrament {
  id             String        @id @default(uuid())
  type           SacramentType
  dateReceived   DateTime
  parishionerId  String
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner   @relation(fields: [parishionerId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
}

model Event {
  id             String            @id @default(uuid())
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  location       String?
  status         EventStatus       @default(SCHEDULED)
  maxAttendees   Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  minutes        String?
  type           EventType         @default(MEETING)
  organizationId String
  societyId      String?
  organization   Organization      @relation(fields: [organizationId], references: [id])
  society        Society?          @relation(fields: [societyId], references: [id])
  attendance     EventAttendance[]
  massIntentions MassIntention[]

  @@index([organizationId])
  @@index([startTime])
}

model EventAttendance {
  id            String      @id @default(uuid())
  eventId       String
  parishionerId String
  status        String      @default("PRESENT")
  createdAt     DateTime    @default(now())
  event         Event       @relation(fields: [eventId], references: [id])
  parishioner   Parishioner @relation(fields: [parishionerId], references: [id])

  @@unique([eventId, parishionerId])
}

model DonationCampaign {
  id             String       @id @default(uuid())
  name           String
  description    String?
  targetAmount   Float
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]

  @@index([organizationId])
  @@index([isActive])
  @@index([startDate])
}

model MassIntention {
  id             String          @id @default(uuid())
  intention      String
  intentionType  IntentionType
  requestedBy    String
  contactEmail   String?
  contactPhone   String?
  stipend        Float?
  parishionerId  String?
  eventId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  notes          String?
  approvedAt     DateTime?
  approvedBy     String?
  massId         String
  status         IntentionStatus @default(PENDING)
  organizationId String
  event          Event?          @relation(fields: [eventId], references: [id])
  mass           Mass            @relation(fields: [massId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner?    @relation(fields: [parishionerId], references: [id])
  payments       Payment[]

  @@index([parishionerId])
  @@index([organizationId])
  @@index([massId])
  @@index([eventId])
  @@index([status])
}

model DonationType {
  id             String     @id @default(uuid())
  name           String
  description    String?
  organizationId String
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  donations      Donation[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([isActive])
}

model Donation {
  id             String       @id @default(uuid())
  donationTypeId String
  targetAmount   Float?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  donationType   DonationType @relation(fields: [donationTypeId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]

  @@index([donationTypeId])
  @@index([organizationId])
  @@index([isActive])
}

model Payment {
  id                 String            @id @default(uuid())
  amount             Float
  currency           String            @default("NGN")
  purpose            PaymentPurpose
  month              Int?
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus     @default(PENDING)
  transactionRef     String?           @unique
  parishionerId      String?
  payerName          String
  onBehalfOf         String?
  payerEmail         String?
  payerPhone         String?
  massIntentionId    String?
  donationCampaignId String?
  donationId         String?
  recordedById       String
  notes              String?
  receiptNumber      String?           @unique
  paymentDate        DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organizationId     String
  societyId          String?
  donationCampaign   DonationCampaign? @relation(fields: [donationCampaignId], references: [id])
  donation           Donation?         @relation(fields: [donationId], references: [id])
  massIntention      MassIntention?    @relation(fields: [massIntentionId], references: [id])
  organization       Organization      @relation(fields: [organizationId], references: [id])
  parishioner        Parishioner?      @relation(fields: [parishionerId], references: [id])
  recordedBy         User              @relation("PaymentRecorder", fields: [recordedById], references: [id])
  society            Society?          @relation(fields: [societyId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
  @@index([purpose])
  @@index([paymentStatus])
  @@index([massIntentionId])
  @@index([donationCampaignId])
  @@index([donationId])
  @@index([societyId])
  @@index([paymentDate])
  @@index([month])
  @@index([recordedById])
}

model Appointment {
  id                   String                   @id @default(uuid())
  title                String
  description          String?
  startTime            DateTime
  endTime              DateTime
  type                 AppointmentType
  status               AppointmentStatus        @default(PENDING)
  parishionerId        String?
  assignedToId         String?
  requestedById        String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  organizationId       String
  availabilityId       String?
  publicRequesterEmail String?
  publicRequesterName  String?
  publicRequesterPhone String?
  source               AppointmentSource        @default(INTERNAL)
  assignedTo           User?                    @relation("AppointmentAssignee", fields: [assignedToId], references: [id])
  availability         AppointmentAvailability? @relation(fields: [availabilityId], references: [id])
  organization         Organization             @relation(fields: [organizationId], references: [id])
  parishioner          Parishioner?             @relation("ParishionerAppointment", fields: [parishionerId], references: [id])
  requestedBy          User?                    @relation("AppointmentCreator", fields: [requestedById], references: [id])

  @@index([parishionerId])
  @@index([assignedToId])
  @@index([requestedById])
  @@index([availabilityId])
  @@index([organizationId])
  @@index([startTime])
  @@index([source])
}

model AppointmentAvailability {
  id             String          @id @default(uuid())
  title          String
  type           AppointmentType
  startTime      DateTime
  endTime        DateTime
  maxBookings    Int             @default(1)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String
  assignedToId   String?
  appointments   Appointment[]
  assignedTo     User?           @relation("AppointmentAvailabilityAssignee", fields: [assignedToId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, startTime, endTime])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([startTime])
  @@index([isActive])
}

model AppointmentUnavailableDay {
  id             String       @id @default(uuid())
  date           DateTime
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
}

model LiveStream {
  id             String       @id @default(uuid())
  title          String
  description    String?
  streamUrl      String
  isLive         Boolean      @default(false)
  scheduledFor   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([isLive])
  @@index([scheduledFor])
}

model Announcement {
  id             String           @id @default(uuid())
  title          String
  content        String
  targetLevels   HierarchyLevel[]
  isPublished    Boolean          @default(false)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organizationId String
  expiresAt      DateTime?
  imageUrl       String?

  @@index([organizationId])
  @@index([isPublished])
  @@index([expiresAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entityType  String
  entityId    String
  performedBy String
  details     Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([performedBy])
  @@index([createdAt])
}

model Baptism {
  id             String       @id @default(uuid())
  parishionerId  String
  organizationId String
  date           DateTime
  minister       String?
  godparents     String?
  placeOfBaptism String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner  @relation(fields: [parishionerId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
  @@index([date])
}

model Confirmation {
  id                  String       @id @default(uuid())
  parishionerId       String
  organizationId      String
  date                DateTime
  minister            String?
  sponsor             String?
  placeOfConfirmation String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id])
  parishioner         Parishioner  @relation(fields: [parishionerId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
  @@index([date])
}

model Marriage {
  id              String       @id @default(uuid())
  husbandId       String
  wifeId          String
  organizationId  String
  date            DateTime
  priest          String?
  witnesses       String?
  placeOfMarriage String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  husband         Parishioner  @relation("MarriageHusband", fields: [husbandId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
  wife            Parishioner  @relation("MarriageWife", fields: [wifeId], references: [id])

  @@index([husbandId])
  @@index([wifeId])
  @@index([organizationId])
  @@index([date])
}

enum HierarchyLevel {
  PARISH
  OUTSTATION
}

enum MassType {
  DAILY_MASS
  SUNDAY_MASS
  HOLY_DAY_MASS
  SPECIAL_MASS
  WEDDING_MASS
  FUNERAL_MASS
  THANKSGIVING_MASS
}

enum MassStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum IntentionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  PARISH_ADMIN
  PARISH_SECRETARY
  PARISH_STAFF
  OUTSTATION_ADMIN
  SOCIETY_PRESIDENT
  SOCIETY_SECRETARY
  PARISHIONER
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SocietyRole {
  MEMBER
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  PRO
  OTHER
}

enum SacramentType {
  BAPTISM
  FIRST_COMMUNION
  CONFIRMATION
  MARRIAGE
  ANOINTING_OF_THE_SICK
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EventType {
  MEETING
  ACTIVITY
  FUNDRAISER
  OTHER
}

enum IntentionType {
  THANKSGIVING
  REQUIEM
  SPECIAL_INTENTION
}

enum PaymentPurpose {
  OFFERING
  TITHE
  MASS_INTENTION
  DONATION_CAMPAIGN
  CUSTOM_DONATION
  OTHER
  SOCIETY_DUES
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  CHECK
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AppointmentType {
  CONFESSION
  COUNSELING
  MEETING
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentSource {
  INTERNAL
  PUBLIC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PERMISSION_CHANGE
  PAYMENT_RECORDED
  MASS_INTENTION_BOOKED
  APPOINTMENT_BOOKED
  LIVESTREAM_STARTED
  DONATION_CAMPAIGN_CREATED
}
