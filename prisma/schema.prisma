generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Organization {
  id                    String                       @id @default(uuid())
  name                  String                       @unique
  level                 HierarchyLevel
  parentId              String?
  address               String?
  contactEmail          String?
  contactPhone          String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  autoGenerateMasses    Boolean                      @default(true)
  generateDaysInAdvance Int                          @default(90)
  maxMassesPerDay       Int                          @default(5)
  minMassesPerDay       Int                          @default(1)
  appointments          Appointment[]
  donations             Donation[]
  donationCampaigns     DonationCampaign[]
  events                Event[]
  announcements         Announcement[]
  liveStreams           LiveStream[]
  masses                Mass[]
  massIntentions        MassIntention[]
  massScheduleTemplates MassScheduleTemplate[]
  parent                Organization?                @relation("ChildOrganizations", fields: [parentId], references: [id])
  children              Organization[]               @relation("ChildOrganizations")
  featureSettings       OrganizationFeatureSettings?
  parishioners          Parishioner[]
  payments              Payment[]
  societys              society[]
  sacraments            Sacrament[]
  users                 User[]

  @@index([parentId])
}

model OrganizationFeatureSettings {
  id                          String       @id @default(uuid())
  organizationId              String       @unique
  enableParishionerManagement Boolean      @default(true)
  enableSacramentalRecords    Boolean      @default(true)
  enableFinancialManagement   Boolean      @default(true)
  enableOfferings             Boolean      @default(true)
  enableTithes                Boolean      @default(true)
  enableDonationCampaigns     Boolean      @default(true)
  enableCustomDonationTypes   Boolean      @default(true)
  enableMonthlyTracking       Boolean      @default(true)
  enableMassIntentions        Boolean      @default(true)
  enableAppointments          Boolean      @default(true)
  enableConfessionBooking     Boolean      @default(true)
  enableLiveStreaming         Boolean      @default(false)
  enableAnnouncements         Boolean      @default(true)
  enableSMSNotifications      Boolean      @default(false)
  enableEmailNotifications    Boolean      @default(true)
  enablesocietys              Boolean      @default(true)
  enableEventManagement       Boolean      @default(true)
  enableOnlinePayments        Boolean      @default(false)
  enableRecurringDonations    Boolean      @default(false)
  enableMobileApp             Boolean      @default(false)
  enablePublicWebsite         Boolean      @default(true)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  organization                Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  password             String
  firstName            String
  lastName             String
  role                 UserRole
  organizationId       String
  isActive             Boolean              @default(true)
  lastLogin            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  appointmentsAssigned Appointment[]        @relation("AppointmentAssignee")
  appointmentsMade     Appointment[]        @relation("AppointmentCreator")
  passwordResetTokens  PasswordResetToken[]
  paymentsRecorded     Payment[]            @relation("PaymentRecorder")
  societyLed           society?             @relation("societyPresident")
  societyAssisted      society?             @relation("societySecretary")
  organization         Organization         @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model MassScheduleTemplate {
  id             String       @id @default(uuid())
  organizationId String
  dayOfWeek      DayOfWeek
  time           String
  massType       MassType     @default(DAILY_MASS)
  language       String?
  location       String?
  isActive       Boolean      @default(true)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([dayOfWeek])
  @@index([isActive])
}

model Mass {
  id                 String          @id @default(uuid())
  organizationId     String
  date               DateTime
  time               String
  massType           MassType
  status             MassStatus      @default(SCHEDULED)
  language           String?
  location           String?
  celebrant          String?
  maxIntentions      Int             @default(1)
  bookedIntentions   Int             @default(0)
  templateId         String?
  isAutoGenerated    Boolean         @default(true)
  modifiedBy         String?
  cancellationReason String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  organization       Organization    @relation(fields: [organizationId], references: [id])
  intentions         MassIntention[]

  @@unique([organizationId, date, time])
  @@index([organizationId])
  @@index([date])
  @@index([status])
  @@index([massType])
}

model society {
  id              String              @id @default(uuid())
  name            String
  description     String?
  organizationId  String
  presidentId     String?             @unique
  secretaryId     String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  meetingSchedule String?
  patronSaint     String?
  events          Event[]
  payments        Payment[]
  organization    Organization        @relation(fields: [organizationId], references: [id])
  president       User?               @relation("societyPresident", fields: [presidentId], references: [id])
  secretary       User?               @relation("societySecretary", fields: [secretaryId], references: [id])
  members         societyMembership[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([presidentId])
  @@index([secretaryId])
}

model Parishioner {
  id                 String              @id @default(uuid())
  firstName          String
  lastName           String
  otherNames         String?
  email              String?             @unique
  phone              String?
  address            String?
  dateOfBirth        DateTime?
  gender             Gender?
  maritalStatus      MaritalStatus?
  organizationId     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  occupation         String?
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  photoUrl           String?
  appointments       Appointment[]       @relation("ParishionerAppointment")
  eventAttendances   EventAttendance[]
  massIntentions     MassIntention[]
  organization       Organization        @relation(fields: [organizationId], references: [id])
  payments           Payment[]
  societyMemberships societyMembership[]
  sacraments         Sacrament[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model societyMembership {
  parishionerId String
  societyId     String
  joinedAt      DateTime    @default(now())
  role          societyRole @default(MEMBER)
  parishioner   Parishioner @relation(fields: [parishionerId], references: [id])
  society       society     @relation(fields: [societyId], references: [id])

  @@id([parishionerId, societyId])
  @@index([societyId])
}

model Sacrament {
  id             String        @id @default(uuid())
  type           SacramentType
  dateReceived   DateTime
  parishionerId  String
  organizationId String
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner   @relation(fields: [parishionerId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
}

model Event {
  id             String            @id @default(uuid())
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  location       String?
  organizationId String
  status         EventStatus       @default(SCHEDULED)
  maxAttendees   Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  societyId      String?
  minutes        String?
  type           EventType         @default(MEETING)
  organization   Organization      @relation(fields: [organizationId], references: [id])
  society        society?          @relation(fields: [societyId], references: [id])
  attendance     EventAttendance[]
  massIntentions MassIntention[]

  @@index([organizationId])
  @@index([startTime])
}

model EventAttendance {
  id            String      @id @default(uuid())
  eventId       String
  parishionerId String
  status        String      @default("PRESENT")
  createdAt     DateTime    @default(now())
  event         Event       @relation(fields: [eventId], references: [id])
  parishioner   Parishioner @relation(fields: [parishionerId], references: [id])

  @@unique([eventId, parishionerId])
}

model DonationCampaign {
  id             String       @id @default(uuid())
  name           String
  description    String?
  targetAmount   Float
  startDate      DateTime
  endDate        DateTime?
  organizationId String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]

  @@index([organizationId])
  @@index([isActive])
  @@index([startDate])
}

model MassIntention {
  id             String          @id @default(uuid())
  intention      String
  intentionType  IntentionType
  requestedBy    String
  contactEmail   String?
  contactPhone   String?
  stipend        Float?
  parishionerId  String?
  organizationId String
  eventId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  notes          String?
  approvedAt     DateTime?
  approvedBy     String?
  massId         String
  status         IntentionStatus @default(PENDING)
  event          Event?          @relation(fields: [eventId], references: [id])
  mass           Mass            @relation(fields: [massId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner?    @relation(fields: [parishionerId], references: [id])
  payments       Payment[]

  @@index([parishionerId])
  @@index([organizationId])
  @@index([massId])
  @@index([eventId])
  @@index([status])
}

model DonationType {
  id             String     @id @default(uuid())
  name           String
  description    String?
  organizationId String
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  donations      Donation[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([isActive])
}

model Donation {
  id             String       @id @default(uuid())
  donationTypeId String
  organizationId String
  targetAmount   Float?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  donationType   DonationType @relation(fields: [donationTypeId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]

  @@index([donationTypeId])
  @@index([organizationId])
  @@index([isActive])
}

model Payment {
  id                 String            @id @default(uuid())
  amount             Float
  currency           String            @default("NGN")
  purpose            PaymentPurpose
  month              Int?
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus     @default(PENDING)
  transactionRef     String?           @unique
  parishionerId      String?
  payerName          String
  onBehalfOf         String?
  payerEmail         String?
  payerPhone         String?
  massIntentionId    String?
  donationCampaignId String?
  donationId         String?
  organizationId     String
  recordedById       String
  notes              String?
  receiptNumber      String?           @unique
  paymentDate        DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  societyId          String?
  donationCampaign   DonationCampaign? @relation(fields: [donationCampaignId], references: [id])
  donation           Donation?         @relation(fields: [donationId], references: [id])
  massIntention      MassIntention?    @relation(fields: [massIntentionId], references: [id])
  organization       Organization      @relation(fields: [organizationId], references: [id])
  parishioner        Parishioner?      @relation(fields: [parishionerId], references: [id])
  society            society?          @relation(fields: [societyId], references: [id])
  recordedBy         User              @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
  @@index([purpose])
  @@index([paymentStatus])
  @@index([massIntentionId])
  @@index([donationCampaignId])
  @@index([donationId])
  @@index([societyId])
  @@index([paymentDate])
  @@index([month])
  @@index([recordedById])
}

model Appointment {
  id             String            @id @default(uuid())
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  type           AppointmentType
  status         AppointmentStatus @default(PENDING)
  parishionerId  String
  assignedToId   String?
  requestedById  String
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignedTo     User?             @relation("AppointmentAssignee", fields: [assignedToId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner       @relation("ParishionerAppointment", fields: [parishionerId], references: [id])
  requestedBy    User              @relation("AppointmentCreator", fields: [requestedById], references: [id])

  @@index([parishionerId])
  @@index([assignedToId])
  @@index([requestedById])
  @@index([organizationId])
  @@index([startTime])
}

model LiveStream {
  id             String       @id @default(uuid())
  title          String
  description    String?
  streamUrl      String
  organizationId String
  isLive         Boolean      @default(false)
  scheduledFor   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([isLive])
  @@index([scheduledFor])
}

model Announcement {
  id             String           @id @default(uuid())
  title          String
  content        String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  targetLevels   HierarchyLevel[]
  isPublished    Boolean          @default(false)
  publishedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entityType  String
  entityId    String
  performedBy String
  details     Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([performedBy])
  @@index([createdAt])
}

enum HierarchyLevel {
  PARISH
  OUTSTATION
}

enum MassType {
  DAILY_MASS
  SUNDAY_MASS
  HOLY_DAY_MASS
  SPECIAL_MASS
  WEDDING_MASS
  FUNERAL_MASS
  THANKSGIVING_MASS
}

enum MassStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum IntentionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  PARISH_ADMIN
  PARISH_SECRETARY
  PARISH_STAFF
  OUTSTATION_ADMIN
  ORGANIZATION_PRESIDENT
  ORGANIZATION_SECRETARY
  PARISHIONER
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

enum societyRole {
  MEMBER
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  PRO
  OTHER
}

enum SacramentType {
  BAPTISM
  FIRST_COMMUNION
  CONFIRMATION
  MARRIAGE
  ANOINTING_OF_THE_SICK
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EventType {
  MEETING
  ACTIVITY
  FUNDRAISER
  OTHER
}

enum IntentionType {
  THANKSGIVING
  REQUIEM
  SPECIAL_INTENTION
}

enum PaymentPurpose {
  OFFERING
  TITHE
  MASS_INTENTION
  DONATION_CAMPAIGN
  CUSTOM_DONATION
  OTHER
  ORGANIZATION_DUES
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  CHECK
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AppointmentType {
  CONFESSION
  COUNSELING
  MEETING
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PERMISSION_CHANGE
  PAYMENT_RECORDED
  MASS_INTENTION_BOOKED
  APPOINTMENT_BOOKED
  LIVESTREAM_STARTED
  DONATION_CAMPAIGN_CREATED
}
