generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                             String                       @id @default(uuid())
  name                           String                       @unique
  level                          HierarchyLevel
  parentId                       String?
  address                        String?
  contactEmail                   String?
  contactPhone                   String?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  autoGenerateMasses             Boolean                      @default(true)
  generateDaysInAdvance          Int                          @default(90)
  maxMassesPerDay                Int                          @default(5)
  minMassesPerDay                Int                          @default(1)
  appointmentBookingClosesAt     DateTime?
  appointmentBookingOpensAt      DateTime?
  payoutAccountName              String?
  payoutAccountNumber            String?
  payoutBankCode                 String?
  payoutBankName                 String?
  paystackCustomerCode           String?                      @unique
  paystackDedicatedAccountId     String?                      @unique
  paystackDedicatedAccountNumber String?
  paystackDedicatedBankName      String?
  paystackDedicatedProviderSlug  String?
  paystackSubaccountCode         String?                      @unique
  paystackSubaccountName         String?
  paystackSubaccountStatus       PaystackSubaccountStatus     @default(PENDING)
  paystackTransferRecipientCode  String?                      @unique
  appointments                   Appointment[]
  appointmentAvailabilities      AppointmentAvailability[]
  appointmentUnavailableDays     AppointmentUnavailableDay[]
  baptisms                       Baptism[]
  confirmations                  Confirmation[]
  donations                      Donation[]
  donationCampaigns              DonationCampaign[]
  events                         Event[]
  liveStreams                    LiveStream[]
  marriages                      Marriage[]
  masses                         Mass[]
  massIntentions                 MassIntention[]
  massScheduleTemplates          MassScheduleTemplate[]
  parent                         Organization?                @relation("ChildOrganizations", fields: [parentId], references: [id])
  children                       Organization[]               @relation("ChildOrganizations")
  featureSettings                OrganizationFeatureSettings?
  financialEntries               ParishFinancialEntry[]
  parishioners                   Parishioner[]
  payments                       Payment[]
  paymentTypes                   PaymentType[]
  sacraments                     Sacrament[]
  societies                      Society[]
  users                          User[]
  withdrawals                    WithdrawalRequest[]
  userAccountRequests            UserAccountRequest[]
  pushSubscriptions              PushSubscription[]
  accessCodes                    ParishAccessCode[]
  gateCode                       ParishGateCode?

  @@index([parentId])
}

model OrganizationFeatureSettings {
  id                          String       @id @default(uuid())
  organizationId              String       @unique
  enableParishionerManagement Boolean      @default(true)
  enableSacramentalRecords    Boolean      @default(true)
  enableFinancialManagement   Boolean      @default(true)
  enableOfferings             Boolean      @default(true)
  enableTithes                Boolean      @default(true)
  enableDonationCampaigns     Boolean      @default(true)
  enableCustomDonationTypes   Boolean      @default(true)
  enableMonthlyTracking       Boolean      @default(true)
  enableMassIntentions        Boolean      @default(true)
  enableAppointments          Boolean      @default(true)
  enableConfessionBooking     Boolean      @default(true)
  enableLiveStreaming         Boolean      @default(false)
  enableAnnouncements         Boolean      @default(true)
  enableSMSNotifications      Boolean      @default(false)
  enableEmailNotifications    Boolean      @default(true)
  enableEventManagement       Boolean      @default(true)
  enableOnlinePayments        Boolean      @default(false)
  enableRecurringDonations    Boolean      @default(false)
  enableMobileApp             Boolean      @default(false)
  enablePublicWebsite         Boolean      @default(true)
  // When true, the parish's public timeline sits behind a shared gate code.
  // Off by default: most parishes want to be found.
  requireGateCode             Boolean      @default(false)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  enableSocieties             Boolean      @default(true)
  organization                Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model User {
  id                          String                    @id @default(uuid())
  // Nullable since the parish-code sign-in path: a parishioner imported from a
  // paper register has a name and a phone number and nothing else. Postgres
  // permits many NULLs under a unique index, so staff emails stay unique.
  email                       String?                   @unique
  password                    String?
  firstName                   String
  lastName                    String
  role                        UserRole
  isActive                    Boolean                   @default(true)
  lastLogin                   DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  organizationId              String
  address                     String?
  dateOfBirth                 DateTime?
  phone                       String?
  failedLoginAttempts         Int                       @default(0)
  lastFailedLoginAt           DateTime?
  lockedUntil                 DateTime?
  sessionVersion              Int                       @default(1)
  activeSessionId             String?
  twoFactorConfirmedAt        DateTime?
  twoFactorEnabled            Boolean                   @default(false)
  twoFactorMethod             TwoFactorMethod?
  twoFactorSecret             String?
  displayPicture              String?
  // Whether the parish-code door works for this account. Parishioners may
  // switch it off once they hold a verified email, a password and two-factor —
  // staff never had it in the first place. Always re-enableable, so nobody can
  // trap themselves out of their own account.
  allowCodeSignIn             Boolean                   @default(true)
  // Set when a one-time code sent to `email` was confirmed. Cleared whenever
  // the address changes, so it always refers to the address currently on file.
  emailVerifiedAt             DateTime?
  appointmentsAssigned        Appointment[]             @relation("AppointmentAssignee")
  appointmentsMade            Appointment[]             @relation("AppointmentCreator")
  availabilitySlots           AppointmentAvailability[] @relation("AppointmentAvailabilityAssignee")
  liveStreamsCreated          LiveStream[]              @relation("LiveStreamCreator")
  financialEntriesRecorded    ParishFinancialEntry[]    @relation("FinancialEntryRecorder")
  passwordResetTokens         PasswordResetToken[]
  paymentsRecorded            Payment[]                 @relation("PaymentRecorder")
  paymentTypesCreated         PaymentType[]             @relation("PaymentTypeCreator")
  PaymentType                 PaymentType[]
  reviewedJoinRequests        SocietyJoinRequest[]      @relation("JoinRequestReviewer")
  twoFactorChallenges         TwoFactorChallenge[]
  twoFactorSetupTokens        TwoFactorSetupToken[]
  organization                Organization              @relation(fields: [organizationId], references: [id])
  sessions                    UserSession[]
  withdrawalsRequested        WithdrawalRequest[]       @relation("WithdrawalRequester")
  userAccountRequestsCreated  UserAccountRequest[]      @relation("RequestedBy")
  userAccountRequestsReviewed UserAccountRequest[]      @relation("ReviewedBy")
  pushSubscriptions           PushSubscription[]
  emailVerificationTokens     EmailVerificationToken[]
  parishioner                 Parishioner?              @relation("ParishionerAccount")
  accessCodesIssued           ParishAccessCode[]        @relation("AccessCodeIssuer")

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model TwoFactorSetupToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TwoFactorChallenge {
  id             String          @id @default(uuid())
  userId         String
  method         TwoFactorMethod
  challengeToken String          @unique
  codeHash       String?
  expiresAt      DateTime
  consumedAt     DateTime?
  attempts       Int             @default(0)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([consumedAt])
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  tokenId     String    @unique
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  // "password" for staff, "parish-code" for device-bound members. Staff keep
  // one live session and a 30-minute idle timeout; members hold several
  // devices for months. See auth.config.ts.
  authMethod  String    @default("password")
  // "Tecno Spark · Chrome" — what the Devices screen shows.
  deviceLabel String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// A one-time code emailed to prove an address actually reaches its owner.
///
/// `email` records the address the code was sent to, so a code cannot be
/// redeemed against an address changed after it was issued — otherwise someone
/// could request a code to an address they control, change the account email,
/// and mark the new one verified.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A one-time code the parish office issues so a person can bind their phone
/// to their register entry. Stored as a bcrypt hash: the office reads the code
/// out once at issue time and it is never recoverable from the database, so a
/// dump does not hand over the parish.
model ParishAccessCode {
  id             String       @id @default(uuid())
  organizationId String
  parishionerId  String
  codeHash       String
  issuedById     String
  issuedAt       DateTime     @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  attempts       Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner  @relation(fields: [parishionerId], references: [id], onDelete: Cascade)
  issuedBy       User         @relation("AccessCodeIssuer", fields: [issuedById], references: [id])

  @@index([organizationId])
  @@index([parishionerId])
  @@index([expiresAt])
}

/// The optional shared code that gates a parish's public timeline. One per
/// parish, hashed, rotatable by the parish admin.
model ParishGateCode {
  id             String       @id @default(uuid())
  organizationId String       @unique
  codeHash       String
  isActive       Boolean      @default(true)
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

/// Durable rate-limit counters for gate-code and access-code entry. Keyed by a
/// caller-built string ("gate:<orgId>:<ipHash>", "code:<parishionerId>") so one
/// table serves both paths. Rows are disposable; a sweep can delete anything
/// past resetAt.
model AuthAttemptBucket {
  id           String    @id @default(uuid())
  key          String    @unique
  count        Int       @default(0)
  resetAt      DateTime
  blockedUntil DateTime?

  @@index([resetAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model UserAccountRequest {
  id             String                   @id @default(uuid())
  organizationId String
  requestedById  String
  reviewedById   String?
  firstName      String
  lastName       String
  email          String
  role           UserRole
  message        String?
  status         UserAccountRequestStatus @default(PENDING)
  createdAt      DateTime                 @default(now())
  reviewedAt     DateTime?
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User                     @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy     User?                    @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@index([email])
}

model MassScheduleTemplate {
  id             String       @id @default(uuid())
  dayOfWeek      DayOfWeek
  time           String
  massType       MassType     @default(DAILY_MASS)
  language       String?
  location       String?
  isActive       Boolean      @default(true)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([dayOfWeek])
  @@index([isActive])
}

model Mass {
  id                 String            @id @default(uuid())
  date               DateTime
  time               String
  massType           MassType
  status             MassStatus        @default(SCHEDULED)
  language           String?
  location           String?
  celebrant          String?
  maxIntentions      Int               @default(1)
  bookedIntentions   Int               @default(0)
  templateId         String?
  isAutoGenerated    Boolean           @default(true)
  modifiedBy         String?
  cancellationReason String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organizationId     String
  liveStream         LiveStream?
  organization       Organization      @relation(fields: [organizationId], references: [id])
  intentions         MassIntention[]
  MassPaymentType    MassPaymentType[]

  @@unique([organizationId, date, time])
  @@index([organizationId])
  @@index([date])
  @@index([status])
  @@index([massType])
}

model Society {
  id               String               @id @default(uuid())
  name             String
  description      String?
  organizationId   String
  presidentId      String?              @unique
  secretaryId      String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  meetingSchedule  String?
  patronSaint      String?
  monthlyDueAmount Float?
  announcements    Announcement[]
  events           Event[]
  payments         Payment[]
  organization     Organization         @relation(fields: [organizationId], references: [id])
  president        Parishioner?         @relation("SocietyPresident", fields: [presidentId], references: [id])
  secretary        Parishioner?         @relation("SocietySecretary", fields: [secretaryId], references: [id])
  joinRequests     SocietyJoinRequest[]
  members          SocietyMembership[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([presidentId])
  @@index([secretaryId])
}

model Parishioner {
  id                 String               @id @default(uuid())
  firstName          String
  lastName           String
  otherNames         String?
  email              String?              @unique
  phone              String?
  address            String?
  dateOfBirth        DateTime?
  gender             Gender?
  maritalStatus      MaritalStatus?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  occupation         String?
  deletedAt          DateTime?
  isActive           Boolean              @default(true)
  photoUrl           String?
  organizationId     String
  // Real foreign key to the login account. Replaces the email string-match in
  // auth.config.ts, which cannot work once a parishioner has no email.
  userId             String?              @unique
  user               User?                @relation("ParishionerAccount", fields: [userId], references: [id])
  // E.164 form of `phone`, written by lib/phone.ts. This is the lock-in lookup
  // key; `phone` stays as typed so the office still sees what it entered.
  phoneE164          String?
  // Opt-in for the Parish moments feed card. Defaults off: a baptism or a
  // birthday is not public until the person says it is.
  shareMoments       Boolean              @default(false)
  accessCodes        ParishAccessCode[]
  appointments       Appointment[]        @relation("ParishionerAppointment")
  baptisms           Baptism[]
  confirmations      Confirmation[]
  eventAttendances   EventAttendance[]
  marriagesAsHusband Marriage[]           @relation("MarriageHusband")
  marriagesAsWife    Marriage[]           @relation("MarriageWife")
  massIntentions     MassIntention[]
  organization       Organization         @relation(fields: [organizationId], references: [id])
  payments           Payment[]
  sacraments         Sacrament[]
  joinRequests       SocietyJoinRequest[]
  societyMemberships SocietyMembership[]
  societyLed         Society?             @relation("SocietyPresident")
  societyAssisted    Society?             @relation("SocietySecretary")

  @@unique([organizationId, phoneE164])
  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([phoneE164])
}

model SocietyJoinRequest {
  id            String            @id @default(uuid())
  parishionerId String
  societyId     String
  status        JoinRequestStatus @default(PENDING)
  message       String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  parishioner   Parishioner       @relation(fields: [parishionerId], references: [id])
  reviewedBy    User?             @relation("JoinRequestReviewer", fields: [reviewedById], references: [id])
  society       Society           @relation(fields: [societyId], references: [id])

  @@unique([parishionerId, societyId])
  @@index([societyId])
  @@index([parishionerId])
  @@index([status])
}

model SocietyMembership {
  parishionerId  String
  societyId      String
  joinedAt       DateTime    @default(now())
  membershipDate DateTime?
  role           SocietyRole @default(MEMBER)
  parishioner    Parishioner @relation(fields: [parishionerId], references: [id])
  society        Society     @relation(fields: [societyId], references: [id])

  @@id([parishionerId, societyId])
  @@index([societyId])
}

model Sacrament {
  id             String        @id @default(uuid())
  type           SacramentType
  dateReceived   DateTime
  parishionerId  String
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner   @relation(fields: [parishionerId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
}

model Event {
  id             String            @id @default(uuid())
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  location       String?
  status         EventStatus       @default(SCHEDULED)
  maxAttendees   Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  minutes        String?
  type           EventType         @default(MEETING)
  organizationId String
  societyId      String?
  organization   Organization      @relation(fields: [organizationId], references: [id])
  society        Society?          @relation(fields: [societyId], references: [id])
  attendance     EventAttendance[]
  massIntentions MassIntention[]

  @@index([organizationId])
  @@index([startTime])
}

model EventAttendance {
  id            String      @id @default(uuid())
  eventId       String
  parishionerId String
  status        String      @default("PRESENT")
  createdAt     DateTime    @default(now())
  event         Event       @relation(fields: [eventId], references: [id])
  parishioner   Parishioner @relation(fields: [parishionerId], references: [id])

  @@unique([eventId, parishionerId])
}

model DonationCampaign {
  id             String       @id @default(uuid())
  name           String
  description    String?
  targetAmount   Float
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]

  @@index([organizationId])
  @@index([isActive])
  @@index([startDate])
}

model MassIntention {
  id             String          @id @default(uuid())
  intention      String
  intentionType  IntentionType
  requestedBy    String
  intendedFor    String?
  contactEmail   String?
  contactPhone   String?
  stipend        Float?
  parishionerId  String?
  eventId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  notes          String?
  approvedAt     DateTime?
  approvedBy     String?
  massId         String
  status         IntentionStatus @default(PENDING)
  organizationId String
  event          Event?          @relation(fields: [eventId], references: [id])
  mass           Mass            @relation(fields: [massId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner?    @relation(fields: [parishionerId], references: [id])
  payments       Payment[]

  @@index([parishionerId])
  @@index([organizationId])
  @@index([massId])
  @@index([eventId])
  @@index([status])
}

model DonationType {
  id             String     @id @default(uuid())
  name           String
  description    String?
  organizationId String
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  donations      Donation[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([isActive])
}

model Donation {
  id             String       @id @default(uuid())
  donationTypeId String
  targetAmount   Float?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  donationType   DonationType @relation(fields: [donationTypeId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]

  @@index([donationTypeId])
  @@index([organizationId])
  @@index([isActive])
}

model Payment {
  id                 String            @id @default(uuid())
  amount             Float
  currency           String            @default("NGN")
  purpose            PaymentPurpose
  month              Int?
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus     @default(PENDING)
  transactionRef     String?           @unique
  parishionerId      String?
  payerName          String
  onBehalfOf         String?
  payerEmail         String?
  payerPhone         String?
  massIntentionId    String?
  donationCampaignId String?
  donationId         String?
  recordedById       String
  notes              String?
  receiptNumber      String?           @unique
  paymentDate        DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organizationId     String
  societyId          String?
  gateway            PaymentGateway?
  gatewayMeta        Json?
  gatewayReference   String?           @unique
  gatewayStatus      String?
  grossAmount        Float?
  intendedAmount     Float?
  platformFee        Float?
  processorFee       Float?
  paymentTypeId      String?
  donationCampaign   DonationCampaign? @relation(fields: [donationCampaignId], references: [id])
  donation           Donation?         @relation(fields: [donationId], references: [id])
  massIntention      MassIntention?    @relation(fields: [massIntentionId], references: [id])
  organization       Organization      @relation(fields: [organizationId], references: [id])
  parishioner        Parishioner?      @relation(fields: [parishionerId], references: [id])
  paymentType        PaymentType?      @relation(fields: [paymentTypeId], references: [id])
  recordedBy         User              @relation("PaymentRecorder", fields: [recordedById], references: [id])
  society            Society?          @relation(fields: [societyId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
  @@index([purpose])
  @@index([paymentStatus])
  @@index([massIntentionId])
  @@index([donationCampaignId])
  @@index([donationId])
  @@index([societyId])
  @@index([paymentDate])
  @@index([month])
  @@index([recordedById])
  @@index([gateway])
  @@index([gatewayReference])
  @@index([paymentTypeId])
}

model WithdrawalRequest {
  id                String           @id @default(uuid())
  organizationId    String
  requestedById     String
  amount            Float
  currency          String           @default("NGN")
  status            WithdrawalStatus @default(REQUESTED)
  recipientCode     String?
  transferCode      String?
  transferReference String?          @unique
  gatewayStatus     String?
  gatewayMeta       Json?
  failureReason     String?
  notes             String?
  requestedAt       DateTime         @default(now())
  processedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id])
  requestedBy       User             @relation("WithdrawalRequester", fields: [requestedById], references: [id])

  @@index([organizationId])
  @@index([requestedById])
  @@index([status])
  @@index([transferReference])
}

model Appointment {
  id                   String                   @id @default(uuid())
  title                String
  description          String?
  startTime            DateTime
  endTime              DateTime
  type                 AppointmentType
  status               AppointmentStatus        @default(PENDING)
  parishionerId        String?
  assignedToId         String?
  requestedById        String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  organizationId       String
  availabilityId       String?
  publicRequesterEmail String?
  publicRequesterName  String?
  publicRequesterPhone String?
  source               AppointmentSource        @default(INTERNAL)
  assignedTo           User?                    @relation("AppointmentAssignee", fields: [assignedToId], references: [id])
  availability         AppointmentAvailability? @relation(fields: [availabilityId], references: [id])
  organization         Organization             @relation(fields: [organizationId], references: [id])
  parishioner          Parishioner?             @relation("ParishionerAppointment", fields: [parishionerId], references: [id])
  requestedBy          User?                    @relation("AppointmentCreator", fields: [requestedById], references: [id])

  @@index([parishionerId])
  @@index([assignedToId])
  @@index([requestedById])
  @@index([availabilityId])
  @@index([organizationId])
  @@index([startTime])
  @@index([source])
}

model AppointmentAvailability {
  id             String          @id @default(uuid())
  title          String
  type           AppointmentType
  startTime      DateTime
  endTime        DateTime
  maxBookings    Int             @default(1)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String
  assignedToId   String?
  appointments   Appointment[]
  assignedTo     User?           @relation("AppointmentAvailabilityAssignee", fields: [assignedToId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, startTime, endTime])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([startTime])
  @@index([isActive])
}

model AppointmentUnavailableDay {
  id             String       @id @default(uuid())
  date           DateTime
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
}

model LiveStream {
  id             String       @id @default(uuid())
  title          String
  description    String?
  streamUrl      String
  isLive         Boolean      @default(false)
  scheduledFor   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  createdById    String?
  endedAt        DateTime?
  massId         String?      @unique
  startedAt      DateTime?
  createdBy      User?        @relation("LiveStreamCreator", fields: [createdById], references: [id])
  mass           Mass?        @relation(fields: [massId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([isLive])
  @@index([scheduledFor])
  @@index([createdById])
}

model Announcement {
  id              String             @id @default(uuid())
  title           String
  content         String
  targetLevels    HierarchyLevel[]
  isPublished     Boolean            @default(false)
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organizationId  String
  expiresAt       DateTime?
  imageUrl        String?
  approvalStatus  AnnouncementStatus @default(APPROVED)
  createdById     String?
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  societyId       String?
  society         Society?           @relation(fields: [societyId], references: [id])

  @@index([organizationId])
  @@index([isPublished])
  @@index([expiresAt])
  @@index([createdById])
  @@index([approvalStatus])
  @@index([societyId])
}

model PushSubscription {
  id             String       @id @default(uuid())
  endpoint       String       @unique
  p256dh         String
  auth           String
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entityType  String
  entityId    String
  performedBy String
  details     Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([performedBy])
  @@index([createdAt])
}

model Baptism {
  id             String       @id @default(uuid())
  parishionerId  String
  organizationId String
  date           DateTime
  minister       String?
  godparents     String?
  placeOfBaptism String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  parishioner    Parishioner  @relation(fields: [parishionerId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
  @@index([date])
}

model Confirmation {
  id                  String       @id @default(uuid())
  parishionerId       String
  organizationId      String
  date                DateTime
  minister            String?
  sponsor             String?
  placeOfConfirmation String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id])
  parishioner         Parishioner  @relation(fields: [parishionerId], references: [id])

  @@index([parishionerId])
  @@index([organizationId])
  @@index([date])
}

model Marriage {
  id              String       @id @default(uuid())
  husbandId       String
  wifeId          String
  organizationId  String
  date            DateTime
  priest          String?
  witnesses       String?
  placeOfMarriage String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  husband         Parishioner  @relation("MarriageHusband", fields: [husbandId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
  wife            Parishioner  @relation("MarriageWife", fields: [wifeId], references: [id])

  @@index([husbandId])
  @@index([wifeId])
  @@index([organizationId])
  @@index([date])
}

model ParishFinancialEntry {
  id             String                   @id @default(uuid())
  entryType      ParishFinancialEntryType
  title          String
  customTitle    String?
  amount         Float
  date           DateTime
  notes          String?
  organizationId String
  recordedById   String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id])
  recordedBy     User                     @relation("FinancialEntryRecorder", fields: [recordedById], references: [id])

  @@index([organizationId])
  @@index([date])
  @@index([entryType])
}

model PaymentType {
  id             String              @id @default(uuid())
  name           String
  description    String?
  category       PaymentTypeCategory
  isActive       Boolean             @default(true)
  organizationId String
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  userId         String?
  masses         MassPaymentType[]
  payments       Payment[]
  createdBy      User                @relation("PaymentTypeCreator", fields: [createdById], references: [id])
  organization   Organization        @relation(fields: [organizationId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([category])
  @@index([isActive])
}

model MassPaymentType {
  massId        String
  paymentTypeId String
  createdAt     DateTime    @default(now())
  mass          Mass        @relation(fields: [massId], references: [id], onDelete: Cascade)
  paymentType   PaymentType @relation(fields: [paymentTypeId], references: [id], onDelete: Cascade)

  @@id([massId, paymentTypeId])
  @@index([massId])
  @@index([paymentTypeId])
}

